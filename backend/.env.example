# Copiar a .env y ajustar. No subir .env al repositorio.

# PostgreSQL local (crear la base 'boxly' en pgAdmin antes):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=boxly

# Opcional: si se define, tiene prioridad sobre POSTGRES_* (ej. SQLite rápido):
# DATABASE_URL=sqlite:///./boxly.db

# Entorno de ejecución: dev (local) o prod (producción).
# En prod se exige JWT_SECRET_KEY real (>=32 caracteres), DEBUG=false y no se
# exponen /docs ni /openapi.json.
ENVIRONMENT=dev
DEBUG=false

# Secreto para firmar los JWT. Generar uno fuerte con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatorio en producción; en dev, si queda vacío se usa uno inseguro de prueba.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proxy e IP del cliente (auditoría y límites por IP). El backend NUNCA lee
# X-Forwarded-For a mano: la IP real la pone uvicorn/gunicorn solo si la conexión
# viene de un proxy de confianza. Lo lee el servidor, no la app (no va en Settings).
# IPs sueltas del proxy separadas por coma; por defecto solo 127.0.0.1.
# gunicorn 23 NO acepta redes CIDR (172.28.0.0/16 hace que no arranque).
# En docker compose ya viene configurado con la IP fija de Caddy:
# FORWARDED_ALLOW_IPS=172.28.0.10 (ver docker-compose.yml y .env.prod.example).
# Nunca "*" si la API se puede alcanzar sin pasar por el proxy.
# Ver docs/Despliegue.md, sección "Proxy e IP del cliente".
# FORWARDED_ALLOW_IPS=127.0.0.1

# Pagos con Mercado Pago (sandbox). Usar el Access Token de PRUEBA de tu cuenta de desarrollador.
# Sin token, con DEBUG=true los pagos se prueban con POST /api/v1/pagos/{id}/simular.
MP_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:5173
# URL pública https del backend para el webhook (ej. ngrok). Vacía = sin notificaciones.
BACKEND_PUBLIC_URL=
# Secreto para validar la firma de los webhooks de Mercado Pago.
# Generar uno fuerte con: python -c "import secrets; print(secrets.token_urlsafe(48))"
MP_WEBHOOK_SECRET=

# Cuenta de Mercado Pago DE BOXLY (distinta de la de los talleres): es la que cobra
# las suscripciones mensuales de los talleres (cobro automático, docs/Suscripciones.md).
# Sin token, POST /api/v1/suscripcion/cobro-automatico responde 503; en dev+debug el
# cobro se prueba con POST /api/v1/suscripcion/simular-cobro.
BOXLY_MP_ACCESS_TOKEN=
# Secreto para validar la firma de los webhooks de ESA cuenta.
BOXLY_MP_WEBHOOK_SECRET=

# Opcional — script scripts/create_admin.py
BOXLY_ADMIN_EMAIL=admin@boxly.com
BOXLY_ADMIN_PASSWORD=Admin123
BOXLY_ADMIN_NOMBRE=Admin
BOXLY_ADMIN_APELLIDO=Boxly

# Email (Gmail SMTP) - usar App Password de Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM_NAME=Boxly Taller Mecánico
SMTP_FROM_EMAIL=tu-email@gmail.com
SMTP_TLS=true

# Envío por API HTTPS en vez de SMTP, para hostings que bloquean el SMTP saliente.
# Si completás una de estas claves, se usa ese proveedor y se ignora el SMTP.
#  - Resend: el remitente (SMTP_FROM_EMAIL) tiene que ser de un dominio verificado en Resend.
#  - Brevo: el remitente (SMTP_FROM_EMAIL) tiene que ser un remitente verificado en Brevo.
RESEND_API_KEY=
BREVO_API_KEY=

# SOLO DEMO: la contraseña de cada cliente es su DNI/CUIT (sin correo de verificación).
# Es insegura; dejar en false fuera de una demo.
CLIENTE_PASSWORD_DNI=false
