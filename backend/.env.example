# Copiar a .env y ajustar. No subir .env al repositorio.

# PostgreSQL local (crear la base 'boxly' en pgAdmin antes):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=boxly

# Opcional: si se define, tiene prioridad sobre POSTGRES_* (ej. SQLite rápido):
# DATABASE_URL=sqlite:///./boxly.db

JWT_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=true

# Opcional — script scripts/create_admin.py
BOXLY_ADMIN_EMAIL=admin@boxly.com
BOXLY_ADMIN_PASSWORD=Admin123
BOXLY_ADMIN_NOMBRE=Admin
BOXLY_ADMIN_APELLIDO=Boxly
