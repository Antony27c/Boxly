# ============================================================
# Boxly — configuración de producción (docker compose)
#   1. Copiar a .env en la raíz del proyecto:  cp .env.prod.example .env
#   2. Completar los valores y levantar:       docker compose up -d --build
# NUNCA subir .env al repositorio.
# ============================================================

# Dominio público (sin https://). El DNS tipo A tiene que apuntar a este VPS.
# Caddy lo usa para emitir el certificado HTTPS y para las URLs públicas.
DOMINIO=taller.example.com

# --- Base de datos ---
# El contenedor postgres crea el usuario/base con estos valores.
POSTGRES_USER=boxly
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-y-aleatoria
POSTGRES_DB=boxly
POSTGRES_PORT=5432

# URL SQLAlchemy que usa la API (tiene prioridad sobre POSTGRES_*).
# "db" es el nombre del servicio en docker compose; la clave tiene que
# ser la misma que POSTGRES_PASSWORD y conviene usar solo letras y números.
DATABASE_URL=postgresql+psycopg2://boxly:cambiar-por-una-clave-larga-y-aleatoria@db:5432/boxly

ENVIRONMENT=prod
DEBUG=false

# Secreto para firmar los JWT. Generar uno propio con:
#   openssl rand -hex 32
JWT_SECRET_KEY=pegar-aqui-el-secreto-generado
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS: el dominio público (agregar https://www... si aplica).
CORS_ORIGINS=https://taller.example.com

# URLs públicas del sitio: las usa Mercado Pago para volver del pago
# y el backend para armar el webhook.
FRONTEND_URL=https://taller.example.com
BACKEND_PUBLIC_URL=https://taller.example.com

# --- Mercado Pago (producción: Access Token de producción) ---
# Sin token, los pagos quedan en "pendiente" y no se puede cobrar online.
MP_ACCESS_TOKEN=
# Reservado para validar la firma de las notificaciones de MP.
MP_WEBHOOK_SECRET=

# --- Email (Gmail SMTP con contraseña de aplicación de Google) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Boxly Taller Mecánico
SMTP_FROM_EMAIL=
SMTP_TLS=true

# Límite de solicitudes por IP (reservado para cuando se habilite en la API).
RATE_LIMIT_ENABLED=true

# SOLO DEMO: la contraseña de cada cliente es su DNI/CUIT. Nunca en producción.
CLIENTE_PASSWORD_DNI=false

# --- Administrador inicial ---
# Se usan con:  docker compose exec api python -m scripts.create_admin
BOXLY_ADMIN_EMAIL=admin@boxly.com
BOXLY_ADMIN_PASSWORD=cambiar-esta-clave
BOXLY_ADMIN_NOMBRE=Admin
BOXLY_ADMIN_APELLIDO=Boxly
