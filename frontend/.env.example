# URL base de la API de Boxly (FastAPI)
VITE_API_URL=http://localhost:8000

# Turnos y Administración trabajan con datos simulados hasta que se conecten
# a la API. Poner false para consumir la API real en todos los módulos.
VITE_USAR_MOCK=true

# Módulos (separados por coma) que usan la API real aunque VITE_USAR_MOCK=true.
# Opciones: auth, clientes, vehiculos, ordenes, turnos.
VITE_API_REAL=auth,clientes,vehiculos,ordenes,turnos
