# URL base de la API de Boxly (FastAPI)
VITE_API_URL=http://localhost:8000

# true  = datos simulados (mocks) salvo los módulos listados en VITE_API_REAL.
# false = TODOS los módulos usan la API real (incluye Usuarios).
VITE_USAR_MOCK=true

# Módulos (separados por coma) que usan la API real aunque VITE_USAR_MOCK=true.
# Opciones: auth, clientes, vehiculos, ordenes, turnos, repuestos, catalogo.
# Para probar sin mocks, poner VITE_USAR_MOCK=false.
VITE_API_REAL=auth,clientes,vehiculos,ordenes,turnos,repuestos
