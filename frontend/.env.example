# URL base de la API de Boxly (FastAPI)
VITE_API_URL=http://localhost:8000

# Clientes, Vehículos y Turnos trabajan con datos simulados hasta que el
# backend publique sus endpoints. Poner false para consumir la API real.
VITE_USAR_MOCK=true

# Módulos (separados por coma) que usan la API real aunque VITE_USAR_MOCK=true.
# Opciones: auth, clientes. Ej: VITE_API_REAL=auth,clientes
VITE_API_REAL=auth,clientes
